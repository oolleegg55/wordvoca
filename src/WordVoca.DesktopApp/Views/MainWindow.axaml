<Window xmlns="https://github.com/avaloniaui"
        xmlns:avalonia="using:FluentIcons.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordVoca.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:desktopapp="using:WordVoca.DesktopApp"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:WordVoca.Core.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WordVoca.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WordVoca">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

     <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.1" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>
